rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.token.email));
    }

    function hasAppRole() {
      return isSignedIn() &&
        userDoc().data.role in ['admin', 'Santi', 'Guille', 'Victor'];
    }

    function isAdmin() {
      return hasAppRole() && userDoc().data.role == 'admin';
    }

    function isVendedor(data) {
      return isSignedIn() && data.vendedor == request.auth.token.email;
    }

    match /usuarios/{userId} {
      allow get: if isSignedIn() && request.auth.token.email == userId;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /cobros/{cobroId} {
      allow read: if hasAppRole() &&
        (resource.data.vendedor == request.auth.token.email || isAdmin());
      allow create: if hasAppRole() &&
        request.resource.data.vendedor == request.auth.token.email;
      allow update: if hasAppRole() &&
        (isAdmin() ||
         (isVendedor(resource.data) && resource.data.estado == 'pendiente'));
      allow delete: if isAdmin();
    }

    match /cobros_logs/{logId} {
      allow read: if hasAppRole();
      allow create: if hasAppRole();
      allow update, delete: if false;
    }

    match /pedidos/{pedidoId} {
      allow read: if hasAppRole() &&
        (resource.data.vendedor == request.auth.token.email || isAdmin());
      allow create: if hasAppRole() &&
        request.resource.data.vendedor == request.auth.token.email;
      allow update: if hasAppRole() &&
        (isAdmin() ||
         (isVendedor(resource.data) && resource.data.estado != 'facturado'));
      allow delete: if hasAppRole() &&
        (isAdmin() ||
         (isVendedor(resource.data) && resource.data.estado != 'facturado'));
    }

    match /pedidos_logs/{logId} {
      allow read: if hasAppRole();
      allow create: if hasAppRole();
      allow update, delete: if false;
    }

    match /productos/{productoId} {
      allow read: if hasAppRole();
      allow write: if isAdmin();
    }

    match /clientesAlegra/{clienteId} {
      allow read: if hasAppRole();
      allow write: if isAdmin();
    }

    match /hojasDeRuta/{hojaId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /gastos/{gastoId} {
      allow read, write: if isAdmin();
    }

    match /gastos_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
